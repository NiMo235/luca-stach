---
interface Skill {
  name: string;
  level: number;
}

interface Props {
  kicker: string;
  heading: string;
  sub: string;
  toolsLabel: string;
  methodsLabel: string;
  tools: Skill[];
  methods: Skill[];
}

const { kicker, heading, sub, toolsLabel, methodsLabel, tools, methods } = Astro.props;
---

<section id="stack" class="relative border-t border-paper/10 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal">
      <p class="font-mono text-xs text-acid">{kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-5xl" data-scramble>
        {heading}
      </h2>
      <p class="mt-3 max-w-lg font-mono text-xs text-dim sm:text-sm">{sub}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="reveal">
        <h3 class="mb-6 flex items-center gap-2 font-mono text-sm text-warm">
          <span aria-hidden="true">▸</span> {toolsLabel}
        </h3>
        <ul class="space-y-4">
          {
            tools.map((skill, i) => (
              <li>
                <div class="mb-1.5 flex items-baseline justify-between gap-3">
                  <span class="font-mono text-sm text-paper">{skill.name}</span>
                  <span class="font-mono text-[10px] whitespace-nowrap text-faint">
                    {'█'.repeat(skill.level)}
                    <span class="text-paper/10">{'█'.repeat(5 - skill.level)}</span>
                    <span class="ml-1 text-acid">{skill.level}/5</span>
                  </span>
                </div>
                <div
                  class="h-1 w-full bg-paper/10"
                  role="img"
                  aria-label={`${skill.name}: level ${skill.level} of 5`}
                >
                  <div
                    class="bar-fill h-full bg-acid shadow-glow"
                    style={`width: ${skill.level * 20}%; transition-delay: ${i * 60}ms`}
                  />
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="reveal" style="transition-delay: 120ms">
        <h3 class="mb-6 flex items-center gap-2 font-mono text-sm text-warm">
          <span aria-hidden="true">▸</span> {methodsLabel}
        </h3>
        <ul class="space-y-4">
          {
            methods.map((skill, i) => (
              <li>
                <div class="mb-1.5 flex items-baseline justify-between gap-3">
                  <span class="font-mono text-sm text-paper">{skill.name}</span>
                  <span class="font-mono text-[10px] whitespace-nowrap text-faint">
                    {'█'.repeat(skill.level)}
                    <span class="text-paper/10">{'█'.repeat(5 - skill.level)}</span>
                    <span class="ml-1 text-acid">{skill.level}/5</span>
                  </span>
                </div>
                <div
                  class="h-1 w-full bg-paper/10"
                  role="img"
                  aria-label={`${skill.name}: level ${skill.level} of 5`}
                >
                  <div
                    class="bar-fill h-full bg-acid shadow-glow"
                    style={`width: ${skill.level * 20}%; transition-delay: ${i * 60}ms`}
                  />
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
