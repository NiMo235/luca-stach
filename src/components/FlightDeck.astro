---
interface HudStation {
  id: string;
  label: string;
}

interface Props {
  hud: {
    brand: string;
    scrollLabel: string;
    velocityLabel: string;
    stationLabel: string;
    posLabel: string;
    audioOff: string;
    audioOn: string;
    stationsLabel: string;
    stations: HudStation[];
    tcTitle: string;
    tcSubtitle: string;
    tcTriangles: string;
    tcParts: string;
    tcFps: string;
    tcSimAgv: string;
    tcSimTransit: string;
    tcSimDwell: string;
    tcSimModel: string;
    mapTitle: string;
    mapLabel: string;
    mapToggle: string;
    mapFly: string;
    fdManual: string;
    fdPipeline: string;
    fdQueue: string;
  };
  langLabel: string;
  langHref: string;
  stackData: {
    tools: Array<{ name: string; level: number }>;
    methods: Array<{ name: string; level: number }>;
  };
  /* T-104: LOG pallets in the hall — hash + year are language-neutral */
  logData: Array<{ hash: string; year: string }>;
}

const { hud, langLabel, langHref, stackData, logData } = Astro.props;
const langUrl = `${import.meta.env.BASE_URL}${langHref.replace(/^\//, '')}`;

/* T-103 minimap geometry — mirrors src/scripts/halle/layout.ts
   (2 px per meter, hall 120×60 → 240×120, north up; yard strip above).
   Keep in sync when the hall layout moves. */
const MX = (x: number) => (x + 60) * 2;
const rackRows = [-58.3, -52.5, -46.7, -40.9].map((x) => MX(x) - 2.4);
const doors = [
  { x: -50, w: 5 },
  { x: -30, w: 5 },
  { x: -10, w: 5 },
  { x: 10, w: 5 },
  { x: 46, w: 3.2 },
  { x: 55, w: 3.2 },
];
/* clickable zones, station order matches the tour; STACK sits under
   PROOF on the map, so it is drawn first (PROOF wins the click) */
const mapZones = [
  { station: 4, rects: [[192, 64, 44, 52]], lx: 214, ly: 70 }, // STACK mezzanine
  { station: 2, rects: [[0, 28, 56, 64]], lx: 28, ly: 61 }, // LOG high-bay
  { station: 3, rects: [[76, 34, 90, 52], [90, 16, 44, 14]], lx: 121, ly: 61 }, // WORK loop + conveyor
  { station: 0, rects: [[8, 112, 68, 6.8]], lx: 42, ly: 116.4 }, // BOOT gallery
  { station: 5, rects: [[4, 101, 50, 11]], lx: 29, ly: 108 }, // BEYOND lounge
  { station: 6, rects: [[8, 0, 24, 22]], lx: 20, ly: 12 }, // DOCK tor 1
  { station: 1, rects: [[200, 94, 28, 20]], lx: 214, ly: 105 }, // PROOF leitstand
];
const stationLabel = (i: number) => hud.stations[i]?.label ?? '';
---

<canvas
  id="flight-canvas"
  aria-hidden="true"
  data-stack={JSON.stringify(stackData)}
  data-log={JSON.stringify(logData)}
  data-fd={JSON.stringify({ manual: hud.fdManual, pipeline: hud.fdPipeline, queue: hud.fdQueue })}
></canvas>
<div id="flight-flash" aria-hidden="true"></div>

<div id="flight-hud">
  <span class="hud-corner tl" aria-hidden="true"></span>
  <span class="hud-corner tr" aria-hidden="true"></span>
  <span class="hud-corner bl" aria-hidden="true"></span>
  <span class="hud-corner br" aria-hidden="true"></span>

  <p class="hud-brand">{hud.brand}</p>
  <a class="hud-lang" href={langUrl} hreflang={langLabel === 'EN' ? 'en' : 'de'}>{langLabel}</a>

  <nav class="hud-stations" aria-label={hud.stationsLabel}>
    <span class="hud-stations-label" aria-hidden="true">// {hud.stationsLabel}</span>
    {
      hud.stations.map((s, i) => (
        <button type="button" class="hud-station" data-fly={s.id}>
          <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          {s.label}
        </button>
      ))
    }
  </nav>

  <div class="hud-telemetry" aria-hidden="true">
    <span>{hud.scrollLabel} <b class="hud-val" data-hud-scroll>000%</b></span>
    <span>{hud.velocityLabel} <b class="hud-val" data-hud-vel>0.0c</b></span>
    <span>{hud.stationLabel} <b class="hud-val" data-hud-station>01/07</b></span>
    <span>{hud.posLabel} <b class="hud-val" data-hud-pos>X+000.0 Y+000.0 Z+000.0</b></span>
  </div>

  <div class="hud-titlecard" aria-hidden="true">
    <p class="hud-tc-title">{hud.tcTitle}</p>
    <p class="hud-tc-sub">{hud.tcSubtitle}</p>
    <p class="hud-tc-stats">
      <span>{hud.tcTriangles} <b class="hud-val" data-tc-tris>—</b></span>
      <span>{hud.tcParts} <b class="hud-val" data-tc-parts>—</b></span>
      <span>{hud.tcFps} <b class="hud-val" data-tc-fps>—</b></span>
    </p>
    <p class="hud-tc-sim">
      <span>{hud.tcSimAgv} <b class="hud-val" data-tc-agv>—</b></span>
      <span>{hud.tcSimTransit} <b class="hud-val" data-tc-transit>—</b></span>
      <span>{hud.tcSimDwell} <b class="hud-val" data-tc-dwell>—</b></span>
      <span class="hud-tc-model">{hud.tcSimModel}</span>
    </p>
  </div>

  <div class="hud-audio">
    <!-- T-103/T-104: minimap / floor plan — collapsed toggle lives in this
         row, left of the AUDIO button; the open plan floats upward.
         Zone groups are clickable (halle:fly); AGV dots, trucks and the
         camera wedge are updated live from the hall (minimap.ts). -->
    <nav id="halle-map" class="halle-map" aria-label={hud.mapLabel} data-collapsed="true">
      <button
        type="button"
        class="halle-map-toggle"
        aria-expanded="false"
        aria-controls="halle-map-body"
        aria-label={hud.mapToggle}
      >
        <span class="halle-map-title">{hud.mapTitle}</span>
        <span class="halle-map-chevron" aria-hidden="true"></span>
      </button>
      <div class="halle-map-body" id="halle-map-body">
        <svg viewBox="0 -12 240 134" role="group" aria-label={hud.mapLabel}>
          <rect class="mm-yard" x="0" y="-12" width="240" height="12"></rect>
          <rect class="mm-hall" x="0.5" y="0.5" width="239" height="119"></rect>
          {rackRows.map((x) => <rect class="mm-rack" x={x} y="28" width="4.8" height="64" />)}
          <rect class="mm-loop" x="76" y="34" width="108" height="52" rx="16"></rect>
          <rect class="mm-conv" x="90" y="18" width="44" height="12" rx="5"></rect>
          <rect class="mm-cage" x="208" y="2" width="28" height="20"></rect>
          {doors.map((d) => <rect class="mm-door" x={MX(d.x) - d.w} y="-2" width={d.w * 2} height="4" />)}
          {
            mapZones.map((z) => (
              <g
                class="mm-zone"
                data-station={z.station}
                role="button"
                tabindex="0"
                aria-label={hud.mapFly.replace('{station}', stationLabel(z.station))}
              >
                {z.rects.map(([rx, ry, rw, rh]) => (
                  <rect class="mm-zone-rect" x={rx} y={ry} width={rw} height={rh} />
                ))}
                <text class="mm-zone-label" x={z.lx} y={z.ly} text-anchor="middle">
                  {stationLabel(z.station)}
                </text>
              </g>
            ))
          }
          <g data-mm-trucks></g>
          <g data-mm-agvs></g>
          <path class="mm-cam" data-mm-cam d="M0 -4.5 L3.2 3.4 L0 2.2 L-3.2 3.4 Z"></path>
        </svg>
      </div>
    </nav>
    <span class="hud-eq" aria-hidden="true">
      <i style="--k:0.6"></i><i style="--k:1"></i><i style="--k:0.75"></i><i style="--k:0.45"></i><i style="--k:0.9"></i>
    </span>
    <button
      type="button"
      class="hud-audio-toggle"
      data-audio-toggle
      data-label-off={hud.audioOff}
      data-label-on={hud.audioOn}
      aria-pressed="false"
    >
      {hud.audioOff}
    </button>
  </div>
</div>

<div id="flight-corridor" aria-hidden="true"></div>
