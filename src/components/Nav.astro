---
interface NavItem {
  id: string;
  label: string;
}

interface Props {
  langLabel: string;
  langHref: string;
  items: NavItem[];
  status: string;
}

const { langLabel, langHref, items, status } = Astro.props;
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 border-b border-paper/10 bg-ink/80 backdrop-blur-md"
>
  <nav class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 sm:px-6">
    <a
      href="#top"
      class="font-mono text-sm font-bold tracking-tight text-acid glow-acid select-none"
      aria-label="luca stach — top"
    >
      LS_<span class="hero-caret" aria-hidden="true"></span>
    </a>
    <ul class="ml-auto hidden items-center gap-1 md:flex">
      {
        items.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              data-navlink={item.id}
              class="nav-link px-3 py-1.5 font-mono text-xs text-dim transition-colors hover:text-paper"
            >
              <span class="text-faint">./</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="ml-auto flex items-center gap-3 md:ml-4">
      <span class="hidden items-center gap-1.5 font-mono text-[10px] text-faint sm:flex">
        <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-acid shadow-glow"></span>
        {status}
      </span>
      <a
        href={langHref}
        hreflang={langLabel === 'EN' ? 'en' : 'de'}
        class="border border-paper/20 px-2.5 py-1 font-mono text-xs text-paper transition-colors hover:border-acid hover:text-acid"
      >
        {langLabel}
      </a>
    </div>
  </nav>
  <ul class="flex items-center gap-1 overflow-x-auto border-t border-paper/5 px-4 py-2 md:hidden">
    {
      items.map((item) => (
        <li>
          <a
            href={`#${item.id}`}
            data-navlink={item.id}
            class="nav-link whitespace-nowrap px-2 py-1 font-mono text-[11px] text-dim"
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<style>
  .nav-link.is-active {
    color: var(--color-acid);
    background: color-mix(in srgb, var(--color-acid) 8%, transparent);
  }
</style>
