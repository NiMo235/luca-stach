---
import { SEQ_DEFAULT, SEQ_TRACKS } from '../scripts/sequencer';

interface Item {
  title: string;
  text: string;
}

interface Lang {
  name: string;
  level: string;
}

interface Seq {
  title: string;
  play: string;
  stop: string;
  hint: string;
  ariaLabel: string;
}

interface Props {
  kicker: string;
  heading: string;
  items: Item[];
  quote: string;
  langsTitle: string;
  langs: Lang[];
  certsTitle: string;
  certs: string[];
  seq: Seq;
}

const { kicker, heading, items, quote, langsTitle, langs, certsTitle, certs, seq } = Astro.props;
const seqKeys = ['kick', 'hat', 'bass', 'tom'] as const;
---

<section
  id="beyond"
  class="relative border-t border-warm/20 bg-gradient-to-b from-warm/[0.04] to-transparent py-20 sm:py-28"
>
  <div
    class="pointer-events-none absolute top-1/4 -left-40 h-96 w-96 rounded-full bg-warm/5 blur-3xl"
    data-parallax="20"
    aria-hidden="true"
  ></div>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal">
      <p class="font-mono text-xs text-warm">{kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-5xl" data-scramble>
        {heading}
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-3">
      {
        items.map((item, i) => (
          <article class="reveal" style={`transition-delay: ${i * 90}ms`}>
            <h3 class="font-serif text-2xl font-medium text-warm italic">{item.title}</h3>
            <p class="mt-3 font-serif text-lg leading-relaxed text-paper/70 italic">
              {item.text}
            </p>
          </article>
        ))
      }
    </div>

    <blockquote class="reveal mt-16 border-l-2 border-warm/50 pl-6 sm:pl-8">
      <p class="max-w-2xl font-serif text-2xl leading-snug text-paper italic sm:text-3xl">
        {quote}
      </p>
    </blockquote>

    <!-- mini step sequencer (JS only) -->
    <div
      class="toy reveal mt-12 border border-warm/30 bg-ink-2 p-5"
      data-seq
      data-i18n={JSON.stringify(seq)}
      role="group"
      aria-label={seq.ariaLabel}
    >
      <div class="flex items-center justify-between gap-4">
        <p class="font-mono text-[10px] tracking-widest text-faint uppercase">{seq.title}</p>
        <button
          type="button"
          data-seq-play
          aria-pressed="false"
          class="border border-warm/60 px-4 py-1.5 font-mono text-[11px] tracking-widest text-warm uppercase transition-colors hover:bg-warm hover:text-ink"
        >
          {seq.play}
        </button>
      </div>
      <div class="seq-grid mt-4">
        {
          SEQ_TRACKS.map((label, t) => (
            <div class="seq-row">
              <span class="seq-label" aria-hidden="true">
                {label}
              </span>
              {Array.from({ length: 8 }, (_, s) => (
                <button
                  type="button"
                  data-seq-cell
                  data-track={t}
                  data-step={s}
                  aria-pressed={String(SEQ_DEFAULT[seqKeys[t]][s])}
                  class:list={['seq-cell', { 'is-on': SEQ_DEFAULT[seqKeys[t]][s] }]}
                  aria-label={`${label} ${s + 1}`}
                />
              ))}
            </div>
          ))
        }
      </div>
      <p class="mt-3 font-mono text-[10px] text-faint">{seq.hint}</p>
    </div>

    <div class="reveal mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2">
      <div>
        <h3 class="font-mono text-xs tracking-widest text-faint uppercase">{langsTitle}</h3>
        <ul class="mt-4 space-y-2">
          {
            langs.map((lang) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-paper/10 pb-2 font-mono text-sm">
                <span class="text-paper">{lang.name}</span>
                <span class="text-dim">{lang.level}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="font-mono text-xs tracking-widest text-faint uppercase">{certsTitle}</h3>
        <ul class="mt-4 space-y-2">
          {
            certs.map((cert) => (
              <li class="flex items-baseline gap-3 border-b border-paper/10 pb-2 font-mono text-sm">
                <span class="text-warm" aria-hidden="true">
                  ✓
                </span>
                <span class="text-paper">{cert}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
