---
interface Item {
  title: string;
  text: string;
}

interface Lang {
  name: string;
  level: string;
}

interface Props {
  kicker: string;
  heading: string;
  items: Item[];
  quote: string;
  langsTitle: string;
  langs: Lang[];
  certsTitle: string;
  certs: string[];
}

const { kicker, heading, items, quote, langsTitle, langs, certsTitle, certs } = Astro.props;
---

<section
  id="beyond"
  class="relative border-t border-warm/20 bg-gradient-to-b from-warm/[0.04] to-transparent py-20 sm:py-28"
>
  <div
    class="pointer-events-none absolute top-1/4 -left-40 h-96 w-96 rounded-full bg-warm/5 blur-3xl"
    data-parallax="20"
    aria-hidden="true"
  ></div>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal">
      <p class="font-mono text-xs text-warm">{kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-5xl" data-scramble>
        {heading}
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-3">
      {
        items.map((item, i) => (
          <article class="reveal" style={`transition-delay: ${i * 90}ms`}>
            <h3 class="font-serif text-2xl font-medium text-warm italic">{item.title}</h3>
            <p class="mt-3 font-serif text-lg leading-relaxed text-paper/70 italic">
              {item.text}
            </p>
          </article>
        ))
      }
    </div>

    <blockquote class="reveal mt-16 border-l-2 border-warm/50 pl-6 sm:pl-8">
      <p class="max-w-2xl font-serif text-2xl leading-snug text-paper italic sm:text-3xl">
        {quote}
      </p>
    </blockquote>

    <div class="reveal mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2">
      <div>
        <h3 class="font-mono text-xs tracking-widest text-faint uppercase">{langsTitle}</h3>
        <ul class="mt-4 space-y-2">
          {
            langs.map((lang) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-paper/10 pb-2 font-mono text-sm">
                <span class="text-paper">{lang.name}</span>
                <span class="text-dim">{lang.level}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="font-mono text-xs tracking-widest text-faint uppercase">{certsTitle}</h3>
        <ul class="mt-4 space-y-2">
          {
            certs.map((cert) => (
              <li class="flex items-baseline gap-3 border-b border-paper/10 pb-2 font-mono text-sm">
                <span class="text-warm" aria-hidden="true">
                  ✓
                </span>
                <span class="text-paper">{cert}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
