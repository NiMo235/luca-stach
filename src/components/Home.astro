---
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Proof from './Proof.astro';
import Ticker from './Ticker.astro';
import BuildLog from './BuildLog.astro';
import Work from './Work.astro';
import Stack from './Stack.astro';
import Beyond from './Beyond.astro';
import Contact from './Contact.astro';
import FlightDeck from './FlightDeck.astro';

interface HudStation {
  id: string;
  label: string;
}

interface Dict {
  nav: {
    proof: string;
    work: string;
    log: string;
    stack: string;
    beyond: string;
    contact: string;
    langLabel: string;
    langHref: string;
  };
  hero: Record<string, any>;
  proof: Record<string, any>;
  ticker: { items: string[] };
  hud: {
    brand: string;
    scrollLabel: string;
    velocityLabel: string;
    stationLabel: string;
    posLabel: string;
    audioOff: string;
    audioOn: string;
    stationsLabel: string;
    stations: HudStation[];
    tcTitle: string;
    tcSubtitle: string;
    tcTriangles: string;
    tcParts: string;
    tcFps: string;
    tcSimAgv: string;
    tcSimTransit: string;
    tcSimDwell: string;
    tcSimModel: string;
    mapTitle: string;
    mapLabel: string;
    mapToggle: string;
    mapFly: string;
  };
  log: Record<string, any>;
  work: Record<string, any>;
  stack: Record<string, any>;
  beyond: Record<string, any>;
  contact: Record<string, any>;
}

const { t } = Astro.props as { t: Dict };

const navItems = [
  { id: 'proof', label: t.nav.proof },
  { id: 'log', label: t.nav.log },
  { id: 'work', label: t.nav.work },
  { id: 'stack', label: t.nav.stack },
  { id: 'beyond', label: t.nav.beyond },
  { id: 'contact', label: t.nav.contact },
];
---

<Nav
  langLabel={t.nav.langLabel}
  langHref={t.nav.langHref}
  items={navItems}
  status={t.hero.status}
/>
<main>
  <Hero {...t.hero} email={t.contact.email} linkedin={t.contact.linkedin} cvHref={t.contact.cvHref} />
  <Proof {...t.proof} />
  <Ticker items={t.ticker.items} />
  <BuildLog {...t.log} />
  <Work {...t.work} />
  <Stack {...t.stack} />
  <Beyond {...t.beyond} />
</main>
<Contact {...t.contact} />
<FlightDeck
  hud={t.hud}
  langLabel={t.nav.langLabel}
  langHref={t.nav.langHref}
  stackData={{ tools: t.stack.tools, methods: t.stack.methods }}
/>
