---
interface Entry {
  hash: string;
  type: string;
  date: string;
  title: string;
  org: string;
  text: string;
  tags: string[];
}

interface Props {
  kicker: string;
  heading: string;
  sub: string;
  entries: Entry[];
}

const { kicker, heading, sub, entries } = Astro.props;
const typeColors: Record<string, string> = {
  feat: 'text-acid',
  chore: 'text-warm',
  fix: 'text-paper',
};
---

<section id="log" class="relative border-t border-paper/10 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal">
      <p class="font-mono text-xs text-acid">{kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-5xl" data-scramble>
        {heading}
      </h2>
      <p class="mt-3 max-w-lg font-mono text-xs text-dim sm:text-sm">{sub}</p>
    </div>

    <div class="relative mt-14">
      <div
        class="absolute top-0 bottom-0 left-3 w-px bg-gradient-to-b from-acid/60 via-paper/15 to-transparent sm:left-1/2"
        data-parallax="24"
        aria-hidden="true"
      ></div>

      <ol class="space-y-10">
        {
          entries.map((entry, i) => (
            <li class="relative">
              <div
                class:list={[
                  'absolute top-6 left-3 h-2.5 w-2.5 -translate-x-1/2 rounded-full border border-acid bg-ink shadow-glow sm:left-1/2',
                ]}
                aria-hidden="true"
              ></div>
              <div
                class:list={[
                  'reveal ml-10 sm:ml-0 sm:w-[calc(50%-2.5rem)]',
                  i % 2 === 0 ? 'sm:mr-auto' : 'sm:ml-auto',
                ]}
              >
                <article class="card-hover border border-paper/10 bg-ink-2 p-5 sm:p-6">
                  <p class="font-mono text-[11px] text-faint">
                    <span class="text-acid">{entry.hash}</span>
                    <span class:list={['ml-2 font-bold', typeColors[entry.type] ?? 'text-paper']}>
                      {entry.type}:
                    </span>
                    <span class="ml-2 text-dim">{entry.date}</span>
                  </p>
                  <h3 class="mt-3 font-display text-lg font-bold text-paper sm:text-xl">
                    {entry.title}
                  </h3>
                  <p class="mt-1 font-mono text-xs text-warm">{entry.org}</p>
                  <p class="mt-3 text-sm leading-relaxed text-dim">{entry.text}</p>
                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {entry.tags.map((tag) => (
                      <li class="border border-paper/15 px-2 py-0.5 font-mono text-[10px] text-dim">
                        {tag}
                      </li>
                    ))}
                  </ul>
                </article>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
