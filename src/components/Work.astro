---
interface Case {
  id: string;
  title: string;
  context: string;
  text: string;
  results: string[];
  tags: string[];
}

interface Wh {
  title: string;
  hint: string;
  queueLabel: string;
  slotsLabel: string;
  optimize: string;
  reset: string;
  full: string;
  pkgLabel: string;
}

interface Props {
  kicker: string;
  heading: string;
  sub: string;
  cases: Case[];
  wh: Wh;
}

const { kicker, heading, sub, cases, wh } = Astro.props;
---

<section id="work" class="relative border-t border-paper/10 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal">
      <p class="font-mono text-xs text-acid">{kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-5xl" data-scramble>
        {heading}
      </h2>
      <p class="mt-3 max-w-lg font-mono text-xs text-dim sm:text-sm">{sub}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-3">
      {
        cases.map((c, i) => (
          <article
            class="reveal card-hover group flex flex-col border border-paper/10 bg-ink-2"
            data-tilt
            style={`transition-delay: ${i * 90}ms`}
          >
            <div class="tilt-glare" aria-hidden="true"></div>
            <header class="flex items-center justify-between border-b border-paper/10 px-5 py-3">
              <span class="font-mono text-lg font-bold text-outline transition-colors group-hover:text-acid group-hover:[-webkit-text-stroke:0px]">
                {c.id}
              </span>
              <span class="font-mono text-[10px] tracking-wider text-warm uppercase">
                {c.context}
              </span>
            </header>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="font-display text-xl font-bold text-paper">{c.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-dim">{c.text}</p>
              <ul class="mt-5 space-y-2 border-t border-paper/10 pt-4">
                {c.results.map((r) => (
                  <li class="flex gap-2 font-mono text-xs leading-relaxed text-paper/80">
                    <span class="text-acid" aria-hidden="true">
                      +
                    </span>
                    {r}
                  </li>
                ))}
              </ul>
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {c.tags.map((tag) => (
                  <li class="bg-acid-dim px-2 py-0.5 font-mono text-[10px] text-acid">
                    {tag}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <!-- warehouse click-to-store mini-game (JS only) -->
    <div class="toy reveal mt-10 border border-paper/10 bg-ink-2 p-5" data-wh data-i18n={JSON.stringify(wh)}>
      <div class="flex items-baseline justify-between gap-4">
        <p class="font-mono text-[10px] tracking-widest text-faint uppercase">{wh.title}</p>
        <p class="font-mono text-xs font-bold text-acid" data-wh-count>{wh.slotsLabel.toUpperCase()} 00/12</p>
      </div>

      <div class="mt-4">
        <p class="font-mono text-[10px] tracking-widest text-faint uppercase">{wh.queueLabel}</p>
        <div class="wh-queue mt-2" data-wh-queue></div>
      </div>

      <div class="wh-grid mt-4" data-wh-grid role="group" aria-label={wh.slotsLabel}>
        {Array.from({ length: 12 }, (_, i) => <button type="button" class="wh-slot" data-slot={i} />)}
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <button
          type="button"
          data-wh-optimize
          class="border border-acid/50 px-3 py-1.5 font-mono text-[11px] tracking-wider text-acid uppercase transition-colors hover:bg-acid hover:text-ink"
        >
          {wh.optimize}
        </button>
        <button
          type="button"
          data-wh-reset
          class="border border-paper/25 px-3 py-1.5 font-mono text-[11px] tracking-wider text-paper uppercase transition-colors hover:border-acid hover:text-acid"
        >
          {wh.reset}
        </button>
        <p class="font-mono text-xs text-warm" data-wh-msg hidden>{wh.full}</p>
      </div>
      <p class="mt-3 font-mono text-[10px] text-faint">{wh.hint}</p>
    </div>
  </div>
</section>
