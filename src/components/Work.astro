---
interface Case {
  id: string;
  title: string;
  context: string;
  text: string;
  results: string[];
  tags: string[];
}

interface Props {
  kicker: string;
  heading: string;
  sub: string;
  cases: Case[];
  errq: {
    label: string;
    checked: string;
    diverted: string;
    model: string;
    aria: string;
  };
}

const { kicker, heading, sub, cases, errq } = Astro.props;
---

<section id="work" class="relative border-t border-paper/10 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal">
      <p class="font-mono text-xs text-acid">{kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-5xl" data-scramble>
        {heading}
      </h2>
      <p class="mt-3 max-w-lg font-mono text-xs text-dim sm:text-sm">{sub}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-3">
      {
        cases.map((c, i) => (
          <article
            class="reveal card-hover group flex flex-col border border-paper/10 bg-ink-2"
            data-tilt
            style={`transition-delay: ${i * 90}ms`}
          >
            <div class="tilt-glare" aria-hidden="true"></div>
            <header class="flex items-center justify-between border-b border-paper/10 px-5 py-3">
              <span class="font-mono text-lg font-bold text-outline transition-colors group-hover:text-acid group-hover:[-webkit-text-stroke:0px]">
                {c.id}
              </span>
              <span class="font-mono text-[10px] tracking-wider text-warm uppercase">
                {c.context}
              </span>
            </header>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="font-display text-xl font-bold text-paper">{c.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-dim">{c.text}</p>
              <ul class="mt-5 space-y-2 border-t border-paper/10 pt-4">
                {c.results.map((r) => (
                  <li class="flex gap-2 font-mono text-xs leading-relaxed text-paper/80">
                    <span class="text-acid" aria-hidden="true">
                      +
                    </span>
                    {r}
                  </li>
                ))}
              </ul>
              {
                /* Prüfstraße twin (T-104): mirrors the scanner portal in the
                   hall — tapping it cycles the same error quota */
                c.id === '02' && (
                  <div class="mt-4 border border-paper/10 bg-ink px-3 py-2.5" data-fd-only>
                    <p class="font-mono text-[10px] tracking-wider text-faint uppercase">
                      <b class="text-paper/80" data-errq-checked>
                        0
                      </b>{' '}
                      {errq.checked} ·{' '}
                      <b class="text-paper/80" data-errq-diverted>
                        0
                      </b>{' '}
                      {errq.diverted}
                      <span class="ml-2 border border-paper/20 px-1 py-0.5 text-faint">
                        {errq.model}
                      </span>
                    </p>
                    <button
                      type="button"
                      data-errq
                      data-label={errq.label}
                      aria-label={errq.aria}
                      class="mt-2 border border-acid/50 px-3 py-1.5 font-mono text-[11px] tracking-wider text-acid uppercase transition-colors hover:bg-acid hover:text-ink"
                    >
                      {errq.label}: 18 %
                    </button>
                  </div>
                )
              }
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {c.tags.map((tag) => (
                  <li class="bg-acid-dim px-2 py-0.5 font-mono text-[10px] text-acid">
                    {tag}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
