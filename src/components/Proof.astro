---
interface Stat {
  value: number;
  unit?: string;
  prefix?: string;
  decimals?: number;
  label: string;
  detail: string;
}

interface Calc {
  title: string;
  quotesLabel: string;
  minutesLabel: string;
  hoursLabel: string;
  hoursUnit: string;
  paybackLabel: string;
  paybackUnit: string;
  note: string;
}

/* T-104: Leitstand DOM twin (flightdeck only) */
interface Ls {
  title: string;
  model: string;
  tLabel: string;
  queueLabel: string;
  modeLabel: string;
  manual: string;
  pipeline: string;
  switchAria: string;
}

interface Props {
  kicker: string;
  heading: string;
  sub: string;
  stats: Stat[];
  calc: Calc;
  ls: Ls;
}

const { kicker, heading, sub, stats, calc, ls } = Astro.props;
---

<section id="proof" class="relative border-t border-paper/10 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal">
      <p class="font-mono text-xs text-acid">{kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-5xl" data-scramble>
        {heading}
      </h2>
      <p class="mt-3 max-w-lg font-mono text-xs text-dim sm:text-sm">{sub}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-px border border-paper/10 bg-paper/10 sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((stat, i) => (
          <div
            class="reveal group bg-ink-2 p-6 transition-colors hover:bg-ink-3"
            style={`transition-delay: ${i * 80}ms`}
          >
            <p class="font-mono text-[10px] tracking-widest text-faint uppercase">
              [{String(i + 1).padStart(2, '0')}]
            </p>
            <p class="mt-4 font-mono text-4xl font-bold text-acid glow-acid sm:text-5xl">
              {stat.prefix && <span set:html={stat.prefix} />}
              <span
                data-countup
                data-value={stat.value}
                data-decimals={stat.decimals ?? 0}
              >
                {stat.value}
              </span>
              {stat.unit && <span>{stat.unit}</span>}
            </p>
            <p class="mt-3 font-mono text-sm font-medium text-paper">{stat.label}</p>
            <p class="mt-1.5 font-mono text-xs leading-relaxed text-dim">{stat.detail}</p>
          </div>
        ))
      }
    </div>

    <!-- live ROI model (JS only) -->
    <div class="toy reveal mt-6 border border-paper/10 bg-ink-2 p-6" data-roi>
      <p class="font-mono text-[10px] tracking-widest text-faint uppercase">{calc.title}</p>
      <div class="mt-5 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <label class="block font-mono text-xs text-dim">
          <span class="flex items-baseline justify-between gap-3">
            <span>{calc.quotesLabel}</span>
            <span class="text-base font-bold text-acid" data-roi-quotes-val>10</span>
          </span>
          <input
            type="range"
            min="1"
            max="50"
            value="10"
            step="1"
            data-roi-quotes
            aria-label={calc.quotesLabel}
            class="toy-range mt-2"
          />
        </label>
        <label class="block font-mono text-xs text-dim">
          <span class="flex items-baseline justify-between gap-3">
            <span>{calc.minutesLabel}</span>
            <span class="text-base font-bold text-acid" data-roi-minutes-val>25</span>
          </span>
          <input
            type="range"
            min="1"
            max="60"
            value="25"
            step="1"
            data-roi-minutes
            aria-label={calc.minutesLabel}
            class="toy-range mt-2"
          />
        </label>
      </div>
      <div class="mt-6 grid grid-cols-2 gap-px border border-paper/10 bg-paper/10">
        <div class="bg-ink-2 p-4">
          <p class="font-mono text-3xl font-bold text-acid glow-acid sm:text-4xl">
            <span data-roi-hours>0</span><span class="ml-1 text-lg">{calc.hoursUnit}</span>
          </p>
          <p class="mt-1.5 font-mono text-xs text-dim">{calc.hoursLabel}</p>
        </div>
        <div class="bg-ink-2 p-4">
          <p class="font-mono text-3xl font-bold text-acid glow-acid sm:text-4xl">
            <span data-roi-payback>0</span>
          </p>
          <p class="mt-1.5 font-mono text-xs text-dim">{calc.paybackLabel} ({calc.paybackUnit})</p>
        </div>
      </div>
      <p class="mt-3 font-mono text-[10px] leading-relaxed text-faint">{calc.note}</p>
    </div>

    <!-- Leitstand twin (T-104): the ROI sliders steer this sim via
         toy:roi; the switch mirrors the holo switch in the hall -->
    <div class="toy mt-4 border border-paper/10 bg-ink-2 p-5" data-fd-only data-leitstand>
      <p class="font-mono text-[10px] tracking-widest text-faint uppercase">
        {ls.title}
        <span class="ml-2 border border-paper/20 px-1.5 py-0.5 text-faint">{ls.model}</span>
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-3 font-mono text-xs text-dim">
        <span>
          {ls.tLabel}
          <b class="text-acid" data-ls-t>—</b>
        </span>
        <span>
          {ls.queueLabel}
          <b class="text-acid" data-ls-q>—</b>
        </span>
        <button
          type="button"
          data-ls-toggle
          aria-pressed="false"
          aria-label={ls.switchAria}
          class="border border-acid/50 px-3 py-1.5 text-[11px] tracking-wider text-acid uppercase transition-colors hover:bg-acid hover:text-ink"
        >
          {ls.modeLabel}: <span data-ls-mode>{ls.manual}</span>
        </button>
      </div>
    </div>
  </div>
</section>
