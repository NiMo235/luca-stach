---
interface Stat {
  value: number;
  unit?: string;
  prefix?: string;
  decimals?: number;
  label: string;
  detail: string;
}

interface Props {
  kicker: string;
  heading: string;
  sub: string;
  stats: Stat[];
}

const { kicker, heading, sub, stats } = Astro.props;
---

<section id="proof" class="relative border-t border-paper/10 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal">
      <p class="font-mono text-xs text-acid">{kicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-5xl" data-scramble>
        {heading}
      </h2>
      <p class="mt-3 max-w-lg font-mono text-xs text-dim sm:text-sm">{sub}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-px border border-paper/10 bg-paper/10 sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((stat, i) => (
          <div
            class="reveal group bg-ink-2 p-6 transition-colors hover:bg-ink-3"
            style={`transition-delay: ${i * 80}ms`}
          >
            <p class="font-mono text-[10px] tracking-widest text-faint uppercase">
              [{String(i + 1).padStart(2, '0')}]
            </p>
            <p class="mt-4 font-mono text-4xl font-bold text-acid glow-acid sm:text-5xl">
              {stat.prefix && <span set:html={stat.prefix} />}
              <span
                data-countup
                data-value={stat.value}
                data-decimals={stat.decimals ?? 0}
              >
                {stat.value}
              </span>
              {stat.unit && <span>{stat.unit}</span>}
            </p>
            <p class="mt-3 font-mono text-sm font-medium text-paper">{stat.label}</p>
            <p class="mt-1.5 font-mono text-xs leading-relaxed text-dim">{stat.detail}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
